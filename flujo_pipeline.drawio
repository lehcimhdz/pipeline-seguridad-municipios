        <mxCell id="titulo" value="Pipeline v2 · ejecución actual · exclusivamente SEGURIDAD" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#1f4e78;align=center;" vertex="1" parent="1"><mxGeometry x="240" y="20" width="1220" height="50" as="geometry"/></mxCell>
        <mxCell id="input" value="input/word/ · 4 DOCX&#xa;Mismo prefijo municipal&#xa;&#xa;Anexo&#xa;Paquete Seguridad&#xa;Gobierno Abierto&#xa;Desarrollo Urbano" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="210" width="190" height="160" as="geometry"/></mxCell>
        <mxCell id="validar" value="Validar entradas&#xa;Cuatro sufijos únicos&#xa;Municipio y estado&#xa;SHA-256 de fuentes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="260" y="230" width="175" height="120" as="geometry"/></mxCell>
        <mxCell id="extraer" value="Extraer evidencia&#xa;Párrafos y tablas&#xa;Coordenadas de origen&#xa;Control cruzado con Anexo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="475" y="230" width="185" height="120" as="geometry"/></mxCell>
        <mxCell id="calcular" value="Normalizar y calificar&#xa;18 indicadores&#xa;General + último periodo&#xa;Dependencias y candados" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="700" y="230" width="190" height="120" as="geometry"/></mxCell>
        <mxCell id="componer" value="Componer variables&#xa;{snake_case} · listas tipadas&#xa;Resúmenes, análisis y cierres&#xa;Tablas + gráficas de puntajes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="930" y="230" width="195" height="120" as="geometry"/></mxCell>
        <mxCell id="json" value="output/json/&#xa;JSON municipal trazable&#xa;Evidencia + evaluaciones&#xa;Variables + validaciones&#xa;Huellas del contrato v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1165" y="220" width="210" height="140" as="geometry"/></mxCell>

  <diagram id="proceso-estudio" name="Proceso de elaboración">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Estudio de Seguridad Municipal" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#2F3E46;" vertex="1" parent="1"><mxGeometry x="70" y="35" width="850" height="45" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Del paquete de información a una interpretación verificable y una entrega editorial" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="72" y="82" width="900" height="28" as="geometry"/></mxCell>
        <mxCell id="line" value="" style="line;strokeWidth=2;strokeColor=#A8B5B2;" vertex="1" parent="1"><mxGeometry x="70" y="122" width="1460" height="10" as="geometry"/></mxCell>
        <mxCell id="lane1" value="INSUMOS" style="swimlane;html=1;horizontal=1;startSize=34;fillColor=#F6F7F6;swimlaneFillColor=#E6EEEA;strokeColor=#B7C8C1;fontSize=13;fontStyle=1;fontColor=#38524A;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="60" y="165" width="340" height="520" as="geometry"/></mxCell>
        <mxCell id="lane2" value="LECTURA Y VALORACIÓN" style="swimlane;html=1;horizontal=1;startSize=34;fillColor=#F6F7F6;swimlaneFillColor=#E6EEEA;strokeColor=#B7C8C1;fontSize=13;fontStyle=1;fontColor=#38524A;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="425" y="165" width="370" height="520" as="geometry"/></mxCell>
        <mxCell id="lane3" value="REVISIÓN EDITORIAL" style="swimlane;html=1;horizontal=1;startSize=34;fillColor=#F6F7F6;swimlaneFillColor=#E6EEEA;strokeColor=#B7C8C1;fontSize=13;fontStyle=1;fontColor=#38524A;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="820" y="165" width="370" height="520" as="geometry"/></mxCell>
        <mxCell id="lane4" value="ENTREGA" style="swimlane;html=1;horizontal=1;startSize=34;fillColor=#F6F7F6;swimlaneFillColor=#E6EEEA;strokeColor=#B7C8C1;fontSize=13;fontStyle=1;fontColor=#38524A;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1215" y="165" width="325" height="520" as="geometry"/></mxCell>
        <mxCell id="paquete" value="&lt;b&gt;Paquete de Seguridad&lt;/b&gt;&lt;br&gt;Estadísticas, tablas y gráficas existentes" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#6C8E82;fontSize=14;fontColor=#263238;spacing=12;" vertex="1" parent="lane1"><mxGeometry x="35" y="80" width="270" height="115" as="geometry"/></mxCell>
        <mxCell id="anexo" value="&lt;b&gt;Anexo, si está disponible&lt;/b&gt;&lt;br&gt;Contraste de información y apoyo visual" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#9AA9A4;fontSize=13;fontColor=#46534F;spacing=12;" vertex="1" parent="lane1"><mxGeometry x="35" y="240" width="270" height="105" as="geometry"/></mxCell>
        <mxCell id="refnote" value="Datos municipales en input. Complementos sólo para aclaraciones y faltantes." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF9E8;strokeColor=#D6B656;fontSize=12;fontColor=#5E5645;spacing=10;" vertex="1" parent="lane1"><mxGeometry x="35" y="405" width="270" height="65" as="geometry"/></mxCell>
        <mxCell id="leer" value="&lt;b&gt;Preparar la evidencia&lt;/b&gt;&lt;br&gt;Ordenar los 18 indicadores&lt;br&gt;Reconocer títulos y conceptos&lt;br&gt;Registrar fuentes y límites" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8E82;fontSize=14;fontColor=#263238;spacing=12;" vertex="1" parent="lane2"><mxGeometry x="38" y="75" width="295" height="130" as="geometry"/></mxCell>
        <mxCell id="evaluar" value="&lt;b&gt;Evaluar con criterios revisados&lt;/b&gt;&lt;br&gt;Pesos 25 / 35 / 40&lt;br&gt;Ocho prioritarios y candados" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8E82;fontSize=14;fontColor=#263238;spacing=12;" vertex="1" parent="lane2"><mxGeometry x="38" y="275" width="295" height="115" as="geometry"/></mxCell>
        <mxCell id="coverage" value="¿Cobertura por dimensión&lt;br&gt;y seis prioritarios?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF9E8;strokeColor=#D6B656;fontSize=13;fontColor=#5E5645;fontStyle=1;" vertex="1" parent="lane2"><mxGeometry x="65" y="405" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="redactar" value="&lt;b&gt;Interpretar los hallazgos&lt;/b&gt;&lt;br&gt;Redacción editorial y revisión de cifras, contexto e implicaciones&lt;br&gt;Hallazgo → lectura → acción posible" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8E82;fontSize=14;fontColor=#263238;spacing=12;" vertex="1" parent="lane3"><mxGeometry x="38" y="75" width="295" height="130" as="geometry"/></mxCell>
        <mxCell id="verificar" value="&lt;b&gt;Cotejar antes de componer&lt;/b&gt;&lt;br&gt;Cada cifra debe volver a su fuente&lt;br&gt;La prosa no muestra rutas ni apuntes internos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8E82;fontSize=14;fontColor=#263238;spacing=12;" vertex="1" parent="lane3"><mxGeometry x="38" y="275" width="295" height="115" as="geometry"/></mxCell>
        <mxCell id="chartnote" value="Las gráficas seleccionadas se reutilizan tal como fueron entregadas. No se crean gráficas ni tablas nuevas." style="shape=note;whiteSpace=wrap;html=1;fillColor=#F1F5F3;strokeColor=#9AA9A4;fontSize=12;fontColor=#46534F;spacing=10;" vertex="1" parent="lane3"><mxGeometry x="38" y="430" width="295" height="70" as="geometry"/></mxCell>
        <mxCell id="componer" value="&lt;b&gt;Componer el estudio&lt;/b&gt;&lt;br&gt;Sólo el capítulo de Seguridad&lt;br&gt;Aplicar el formato editorial acordado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8E82;fontSize=14;fontColor=#263238;spacing=12;" vertex="1" parent="lane4"><mxGeometry x="30" y="75" width="265" height="115" as="geometry"/></mxCell>
        <mxCell id="auditar" value="&lt;b&gt;Revisión de salida&lt;/b&gt;&lt;br&gt;Formato, variables, procedencia y entrega limpia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8E82;fontSize=14;fontColor=#263238;spacing=12;" vertex="1" parent="lane4"><mxGeometry x="30" y="265" width="265" height="105" as="geometry"/></mxCell>
        <mxCell id="word" value="&lt;b&gt;{municipio} Estudio Seguridad.docx&lt;/b&gt;&lt;br&gt;Documento final para la consultora" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#E4F0EA;strokeColor=#4F7C68;fontSize=14;fontColor=#244536;spacing=12;" vertex="1" parent="lane4"><mxGeometry x="30" y="420" width="265" height="100" as="geometry"/></mxCell>

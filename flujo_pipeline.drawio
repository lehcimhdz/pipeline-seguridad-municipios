        <mxCell id="original" value="ORIGINAL CONSERVADO&#xa;Machote general medicion version final.docx&#xa;&#xa;Se conserva intacto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="50" y="160" width="350" height="150" as="geometry"/></mxCell>
        <mxCell id="migrar" value="MIGRACIÓN MANUAL&#xa;scripts/migrar_machotes_v2.py&#xa;&#xa;Derivar sólo SEGURIDAD&#xa;Portada, 18 indicadores y cierre&#xa;Normalizar marcadores tipados" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="500" y="145" width="350" height="180" as="geometry"/></mxCell>
        <mxCell id="base" value="BASE OPERATIVA&#xa;seguridad_medicion.docx&#xa;&#xa;81 variables · 81 apariciones&#xa;Introducción y síntesis&#xa;Análisis, gráficas, tablas y cierres&#xa;Conclusiones y bibliografía" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="950" y="135" width="420" height="200" as="geometry"/></mxCell>

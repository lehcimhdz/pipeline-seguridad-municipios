  <diagram id="ejecucion-v2" name="1. Ejecución actual · SEGURIDAD">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0"/>

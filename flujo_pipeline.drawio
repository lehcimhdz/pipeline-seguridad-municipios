  <diagram id="machotes-v2" name="2. Machotes, migración y pendientes">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="titulo" value="Machotes de origen → bases operativas de SEGURIDAD" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#1f4e78;align=center;" vertex="1" parent="1"><mxGeometry x="170" y="20" width="1120" height="55" as="geometry"/></mxCell>
        <mxCell id="origen_medicion" value="templates/&#xa;Machote general medicion&#xa;version final.docx&#xa;&#xa;Origen editorial integrado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="135" width="270" height="145" as="geometry"/></mxCell>
        <mxCell id="origen_anexo" value="templates/&#xa;Machote general anexos&#xa;version final.docx&#xa;&#xa;Origen editorial integrado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="270" height="145" as="geometry"/></mxCell>
        <mxCell id="migrar" value="Migración manual de machotes&#xa;python3 scripts/migrar_machotes_v2.py&#xa;&#xa;Normalizar sólo SEGURIDAD&#xa;Variables snake_case en llaves simples&#xa;Corregir duplicado de personal e incluir CUP&#xa;Aplicar manual editorial e incrustar Archivo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="375" y="220" width="355" height="185" as="geometry"/></mxCell>
        <mxCell id="base_medicion" value="templates/seguridad_medicion.docx&#xa;Portada + SEGURIDAD&#xa;Base del perfil medición" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="815" y="150" width="280" height="105" as="geometry"/></mxCell>
        <mxCell id="base_anexo" value="templates/seguridad_anexo.docx&#xa;Portada + SEGURIDAD&#xa;Base del perfil anexo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="815" y="340" width="280" height="105" as="geometry"/></mxCell>
        <mxCell id="contrato" value="Actualizar y validar contrato v2&#xa;config/contrato_documental.json&#xa;Diccionario: 116 variables / 137 apariciones&#xa;Reglas históricas: 18 fichas / 90 criterios&#xa;Formato editorial + hashes de activos&#xa;&#xa;python3 scripts/validar_plantilla.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="805" y="510" width="315" height="185" as="geometry"/></mxCell>
        <mxCell id="runtime" value="Pipeline de un municipio&#xa;(ver página 1)&#xa;&#xa;Usa las bases derivadas&#xa;Valida sus hashes y el contrato&#xa;Publica medición + anexo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1185" y="225" width="255" height="170" as="geometry"/></mxCell>
        <mxCell id="cambios" value="PENDIENTE: detectar cambios del origen en cada corrida&#xa;Se registran origen y origen_sha256, pero la validación de ejecución&#xa;comprueba las bases derivadas. Si cambia un machote general,&#xa;hoy hay que ejecutar la migración manual antes del pipeline." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce5cd;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="690" height="120" as="geometry"/></mxCell>
        <mxCell id="electoral" value="PENDIENTE DE INTEGRACIÓN&#xa;templates/PLATAFORMA ELECTORAL MACHOTE.docx&#xa;&#xa;Está versionado, pero no participa en el contrato ni genera salida.&#xa;Perfil propuesto: plataforma_electoral, sólo SEGURIDAD / Protección Civil.&#xa;Requiere variables, composición de propuestas y revisión editorial propias.&#xa;Usaría el JSON diagnóstico como evidencia; no cambia las reglas de puntaje." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="245" y="760" width="995" height="170" as="geometry"/></mxCell>
        <mxCell id="e1" edge="1" parent="1" source="origen_medicion" target="migrar" style="endArrow=block;edgeStyle=orthogonalEdgeStyle;html=1;"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="e9" style="startArrow=none;exitPerimeter=1;entryPerimeter=1;jettySize=12;exitX=0.5;exitY=1;entryX=0.5;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5C746B;strokeWidth=2;" edge="1" parent="1" source="componer" target="auditar"><mxGeometry relative="1" as="geometry"/></mxCell>

<mxfile host="app.diagrams.net" agent="Codex" version="24.7.17" type="device">
  <diagram id="ejecucion-v21" name="1. Ejecución · SEGURIDAD v2.1">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1060" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="titulo" value="Pipeline v2.1 · dos fuentes · un diagnóstico Word de SEGURIDAD" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#1f4e78;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="30" width="1440" height="60" as="geometry"/></mxCell>
        <mxCell id="fuentes" value="1. FUENTES MUNICIPALES&#xa;input/word/&#xa;&#xa;{municipio} PAQUETE SEGURIDAD.docx&#xa;{municipio} Anexo.docx&#xa;&#xa;Un mismo prefijo municipal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="140" width="290" height="200" as="geometry"/></mxCell>
        <mxCell id="validar" value="2. VALIDAR&#xa;Dos archivos únicos&#xa;Municipio y estado&#xa;Contrato y SHA-256&#xa;Base y reglas vigentes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="360" y="155" width="250" height="170" as="geometry"/></mxCell>
        <mxCell id="extraer" value="3. EXTRAER Y CONTRASTAR&#xa;Párrafos y tablas&#xa;Ámbito municipal / estatal&#xa;Coordenadas de evidencia&#xa;Control cruzado con Anexo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="650" y="155" width="270" height="170" as="geometry"/></mxCell>
        <mxCell id="calificar" value="4. NORMALIZAR Y CALIFICAR&#xa;18 indicadores · 90 criterios&#xa;Umbrales y candados históricos&#xa;General + último periodo&#xa;Faltante = null" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="960" y="150" width="290" height="180" as="geometry"/></mxCell>
        <mxCell id="componer" value="5. COMPONER Y VALIDAR&#xa;Introducción y síntesis&#xa;18 análisis y cierres&#xa;Tablas + gráficas de puntajes&#xa;Conclusiones y bibliografía&#xa;Redacción consultiva sustentada" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="1290" y="135" width="280" height="210" as="geometry"/></mxCell>
        <mxCell id="json" value="6. JSON FUENTE&#xa;Nombre estable&#xa;Ejecución y fuentes SHA-256&#xa;Evidencia y cálculos&#xa;81 variables y validaciones&#xa;contenido_word v2.1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="1290" y="455" width="280" height="190" as="geometry"/></mxCell>
        <mxCell id="render" value="7. RENDERIZAR&#xa;seguridad_medicion.docx&#xa;Manual de medición · Archivo&#xa;Sin resaltado amarillo&#xa;Modo borrador o final" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="960" y="470" width="290" height="160" as="geometry"/></mxCell>
        <mxCell id="auditar" value="8. AUDITAR Y EMITIR RECIBO&#xa;Coherencia de inserciones&#xa;Marcadores resueltos&#xa;Tipografía y formato&#xa;Huella de JSON y Word" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="650" y="470" width="270" height="160" as="geometry"/></mxCell>
        <mxCell id="publicar" value="PUBLICACIÓN EXITOSA&#xa;Un JSON fuente + un Word + un recibo&#xa;Nombres estables · trazabilidad SHA-256&#xa;Después: limpiar salidas anteriores" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="100" y="465" width="510" height="170" as="geometry"/></mxCell>
        <mxCell id="periodos" value="PERIODOS Y FALTANTES&#xa;Último periodo: dos años consecutivos al cierre documental.&#xa;Los años y vacíos conservan su significado en la fuente.&#xa;Cero exige evidencia; una calificación incompleta queda PENDIENTE." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=12;" vertex="1" parent="1"><mxGeometry x="100" y="770" width="670" height="150" as="geometry"/></mxCell>
        <mxCell id="control" value="CONTROL DE PUBLICACIÓN&#xa;Borrador: explica pendientes y requiere revisión.&#xa;Final: puntajes completos, revisión cerrada y coherencia.&#xa;Si falla la generación: no limpiar salidas anteriores.&#xa;--word ninguno conserva sólo el JSON y limpia Word/recibos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=12;" vertex="1" parent="1"><mxGeometry x="830" y="755" width="690" height="180" as="geometry"/></mxCell>
        <mxCell id="edge-0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="fuentes" target="validar"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="edge-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="auditar" target="publicar"><mxGeometry relative="1" as="geometry"/></mxCell>

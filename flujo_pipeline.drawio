        <mxCell id="editorial" value="FORMATO Y REDACCIÓN&#xa;config/formato_editorial.json&#xa;config/redaccion_consultoria.json&#xa;ESTILO_REDACCION.md · assets/fonts/&#xa;&#xa;Archivo · sin resaltado amarillo&#xa;Prosa sustentada en las dos fuentes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=12;" vertex="1" parent="1"><mxGeometry x="500" y="470" width="350" height="200" as="geometry"/></mxCell>
        <mxCell id="contrato" value="DICCIONARIO Y CONTRATO&#xa;Tipos y apariciones de marcadores&#xa;Orden de los indicadores&#xa;Versiones y huellas SHA-256&#xa;&#xa;Original, base, metodología, reglas,&#xa;diccionario, formato, redacción y fuentes tipográficas&#xa;Un solo perfil documental: medicion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="950" y="455" width="420" height="230" as="geometry"/></mxCell>

        <mxCell id="pendiente" value="&lt;b&gt;Revisar los faltantes concretos&lt;/b&gt;&lt;br&gt;La lectura provisional no completa la cobertura. Se conserva la entrega anterior." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF9E8;strokeColor=#D6B656;fontSize=12;fontColor=#5E5645;spacing=12;" vertex="1" parent="1"><mxGeometry x="465" y="735" width="290" height="85" as="geometry"/></mxCell>
        <mxCell id="footer" value="La evidencia, los criterios y la interpretación permanecen vinculados; el documento final sólo muestra el estudio." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F3;strokeColor=none;fontColor=#46534F;fontSize=13;align=center;spacing=10;" vertex="1" parent="1"><mxGeometry x="260" y="860" width="1080" height="45" as="geometry"/></mxCell>

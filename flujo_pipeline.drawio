        <mxCell id="title" value="Referencias que organizan el estudio" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#2F3E46;" vertex="1" parent="1"><mxGeometry x="70" y="35" width="900" height="45" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Cada documento tiene una función específica y ninguno sustituye a los demás." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="72" y="82" width="900" height="28" as="geometry"/></mxCell>
        <mxCell id="line" value="" style="line;strokeWidth=2;strokeColor=#A8B5B2;" vertex="1" parent="1"><mxGeometry x="70" y="122" width="1460" height="10" as="geometry"/></mxCell>
        <mxCell id="consultora" value="&lt;b&gt;Formato de la consultora&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Machote general medicion version final.docx&lt;/font&gt;&lt;br&gt;&lt;br&gt;Define la portada, el orden del capítulo y el aspecto del documento que se entrega." style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#6C8E82;fontSize=14;fontColor=#263238;spacing=14;" vertex="1" parent="1"><mxGeometry x="100" y="190" width="350" height="185" as="geometry"/></mxCell>
        <mxCell id="guia" value="&lt;b&gt;Guía de interpretación&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;… rzg investigación.docx&lt;/font&gt;&lt;br&gt;&lt;br&gt;Ayuda a formular las preguntas, el argumento y las propuestas de cada apartado." style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#6C8E82;fontSize=14;fontColor=#263238;spacing=14;" vertex="1" parent="1"><mxGeometry x="625" y="190" width="350" height="185" as="geometry"/></mxCell>
        <mxCell id="benchmark" value="&lt;b&gt;Benchmark de evaluación&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Machote_seguridad_general_con_calificacion.docx&lt;/font&gt;&lt;br&gt;&lt;br&gt;Fichas históricas y anexo 2.3: ponderación, definiciones y candados." style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#6C8E82;fontSize=14;fontColor=#263238;spacing=14;" vertex="1" parent="1"><mxGeometry x="1150" y="190" width="350" height="185" as="geometry"/></mxCell>
        <mxCell id="base" value="&lt;b&gt;Base de trabajo: SEGURIDAD&lt;/b&gt;&lt;br&gt;25 variables textuales&lt;br&gt;Capítulo y bibliografía&lt;br&gt;Sin instrucciones visibles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3EF;strokeColor=#6C8E82;fontSize=14;fontColor=#244536;spacing=12;" vertex="1" parent="1"><mxGeometry x="122.5" y="505" width="305" height="125" as="geometry"/></mxCell>
        <mxCell id="metodo" value="&lt;b&gt;Metodología de evaluación&lt;/b&gt;&lt;br&gt;Criterios generales, correspondencias y cobertura. No aporta cifras municipales." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E8;strokeColor=#D6B656;fontSize=14;fontColor=#5E5645;spacing=12;" vertex="1" parent="1"><mxGeometry x="1172.5" y="505" width="305" height="125" as="geometry"/></mxCell>
        <mxCell id="redaccion" value="&lt;b&gt;Interpretación municipal&lt;/b&gt;&lt;br&gt;Las cifras del paquete sostienen una lectura clara, prudente y útil para la toma de decisiones." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F3;strokeColor=#6C8E82;fontSize=14;fontColor=#263238;spacing=12;" vertex="1" parent="1"><mxGeometry x="647.5" y="505" width="305" height="125" as="geometry"/></mxCell>
        <mxCell id="final" value="&lt;b&gt;Estudio de Seguridad Municipal&lt;/b&gt;&lt;br&gt;Documento de la consultora con interpretación, calificación declarada y gráficas originales seleccionadas." style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#E4F0EA;strokeColor=#4F7C68;fontSize=16;fontColor=#244536;spacing=14;" vertex="1" parent="1"><mxGeometry x="570" y="755" width="460" height="150" as="geometry"/></mxCell>
        <mxCell id="e1" style="startArrow=none;exitPerimeter=1;entryPerimeter=1;jettySize=12;exitX=0.5;exitY=1;entryX=0.5;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5C746B;strokeWidth=2;" edge="1" parent="1" source="consultora" target="base"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="startArrow=none;exitPerimeter=1;entryPerimeter=1;jettySize=12;exitX=0.5;exitY=1;entryX=0.5;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5C746B;strokeWidth=2;" edge="1" parent="1" source="guia" target="redaccion"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="startArrow=none;exitPerimeter=1;entryPerimeter=1;jettySize=12;exitX=0.5;exitY=1;entryX=0.5;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5C746B;strokeWidth=2;" edge="1" parent="1" source="benchmark" target="metodo"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="startArrow=none;exitPerimeter=1;entryPerimeter=1;jettySize=12;exitX=0.5;exitY=1;entryX=0.25;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5C746B;strokeWidth=2;" edge="1" parent="1" source="base" target="final"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="275" y="710"/><mxPoint x="685" y="710"/></Array></mxGeometry></mxCell>
        <mxCell id="e5" style="startArrow=none;exitPerimeter=1;entryPerimeter=1;jettySize=12;exitX=0.5;exitY=1;entryX=0.75;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5C746B;strokeWidth=2;" edge="1" parent="1" source="metodo" target="final"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1325" y="710"/><mxPoint x="915" y="710"/></Array></mxGeometry></mxCell>
        <mxCell id="e6" style="startArrow=none;exitPerimeter=1;entryPerimeter=1;jettySize=12;exitX=0.5;exitY=1;entryX=0.5;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5C746B;strokeWidth=2;" edge="1" parent="1" source="redaccion" target="final"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note" value="&lt;b&gt;Referencias y revisión&lt;/b&gt;&lt;br&gt;Formato y guía se conservan. El benchmark interno incorpora un anexo versionado. Ninguna instrucción interna aparece en la entrega." style="shape=note;whiteSpace=wrap;html=1;fillColor=#F6F7F6;strokeColor=#9AA9A4;fontSize=13;fontColor=#46534F;spacing=12;" vertex="1" parent="1"><mxGeometry x="1150" y="755" width="305" height="150" as="geometry"/></mxCell>

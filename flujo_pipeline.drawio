        <mxCell id="e4" style="startArrow=none;exitPerimeter=1;entryPerimeter=1;jettySize=12;exitX=0.5;exitY=1;entryX=0.5;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5C746B;strokeWidth=2;" edge="1" parent="1" source="evaluar" target="coverage"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="sí" style="startArrow=none;exitPerimeter=1;entryPerimeter=1;jettySize=12;exitX=1;exitY=0.5;entryX=0;entryY=0.5;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5C746B;strokeWidth=2;fontSize=11;fontColor=#38524A;labelBackgroundColor=#F6F7F6;" edge="1" parent="1" source="coverage" target="redactar"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="807.5" y="625"/><mxPoint x="807.5" y="305"/></Array></mxGeometry></mxCell>

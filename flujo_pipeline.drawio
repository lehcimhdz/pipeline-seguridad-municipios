        <mxCell id="metodologia" value="reglas_calificacion.json&#xa;Metodología histórica preservada&#xa;18 fichas · 90 criterios&#xa;config/normalizaciones.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="685" y="415" width="225" height="110" as="geometry"/></mxCell>
        <mxCell id="bases" value="Bases operativas (ver página 2)&#xa;seguridad_medicion.docx&#xa;seguridad_anexo.docx&#xa;Contrato, diccionario y manual&#xa;Fuentes Archivo incrustadas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="940" y="420" width="210" height="130" as="geometry"/></mxCell>
        <mxCell id="render" value="Renderizar y auditar&#xa;Perfiles medición + anexo&#xa;Verificar contrato y cálculos&#xa;Formato editorial + amarillo&#xa;Borrador o final validado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1190" y="420" width="200" height="140" as="geometry"/></mxCell>
        <mxCell id="medicion" value="output/word/&#xa;{municipio}_seguridad_&#xa;medicion_{modo}.docx&#xa;Resumen, análisis y visualizaciones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1440" y="405" width="230" height="110" as="geometry"/></mxCell>
        <mxCell id="anexo" value="output/word/&#xa;{municipio}_seguridad_&#xa;anexo_{modo}.docx&#xa;Puntajes y evidencia por ámbito" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1440" y="550" width="230" height="110" as="geometry"/></mxCell>
